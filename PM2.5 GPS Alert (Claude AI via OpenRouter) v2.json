    {
      "parameters": {
        "jsCode": "const aiData = $input.first().json;\nconst prev = $('Process AQI Result').first().json;\n\n// Parse OpenRouter/Claude response format\nlet aiAdvice = prev.advice; // fallback\ntry {\n  aiAdvice = aiData.choices[0].message.content.trim();\n} catch(e) {\n  aiAdvice = prev.advice;\n}\n\nreturn [{\n  json: {\n    ...prev,\n    aiAdvice\n  }\n}];"
      },
