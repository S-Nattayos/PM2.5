        -1120,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const apiData = $input.first().json;\nconst prev = $('Parse GPS Data').first().json;\n\nif (apiData.status !== 'ok') {\n  return [{ json: { error: true, email: prev.email, name: prev.name, message: 'ไม่สามารถดึงข้อมูลค่าฝุ่นได้' } }];\n}\n\nconst aqi = apiData.data.aqi;\nconst station = apiData.data.city.name;\nconst pm25 = apiData.data.iaqi?.pm25?.v ?? 'N/A';\nconst pm10 = apiData.data.iaqi?.pm10?.v ?? 'N/A';\nconst o3 = apiData.data.iaqi?.o3?.v ?? 'N/A';\nconst time = new Date().toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' });\n\nlet status, emoji, advice, color, bgColor;\n\nif (aqi <= 50) {\n  status = 'ดี'; emoji = '🟢'; color = '#2e7d32'; bgColor = '#e8f5e9';\n  advice = 'คุณภาพอากาศดีมาก เหมาะสำหรับกิจกรรมกลางแจ้งทุกประเภท';\n} else if (aqi <= 100) {\n  status = 'ปานกลาง'; emoji = '🟡'; color = '#f57f17'; bgColor = '#fffde7';\n  advice = 'คุณภาพอากาศพอรับได้ กลุ่มเสี่ยง (เด็ก ผู้สูงอายุ ผู้ป่วย) ควรระวัง';\n} else if (aqi <= 150) {\n  status = 'มีผลต่อกลุ่มเสี่ยง'; emoji = '🟠'; color = '#e65100'; bgColor = '#fff3e0';\n  advice = 'กลุ่มเสี่ยงควรลดกิจกรรมกลางแจ้ง และพิจารณาใส่หน้ากากอนามัย';\n} else if (aqi <= 200) {\n  status = 'อันตราย'; emoji = '🔴'; color = '#b71c1c'; bgColor = '#ffebee';\n  advice = 'ทุกคนควรใส่หน้ากาก N95 หลีกเลี่ยงการออกกำลังกายกลางแจ้ง';\n} else {\n  status = 'อันตรายมาก'; emoji = '🟣'; color = '#4a148c'; bgColor = '#f3e5f5';\n  advice = 'ห้ามออกนอกบ้านหากไม่จำเป็น ปิดหน้าต่าง เปิดเครื่องฟอกอากาศ และสวมหน้ากาก N95 ตลอดเวลา';\n}\n\nreturn [{\n  json: {\n    name: prev.name,\n    email: prev.email,\n    lat: prev.lat,\n    lng: prev.lng,\n    station, aqi, pm25, pm10, o3,\n    status, emoji, color, bgColor, advice, time\n  }\n}];"
      },
