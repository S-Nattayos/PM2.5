              "name": "X-Title",
              "value": "PM2.5 Monitor"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"model\": \"anthropic/claude-haiku-4-5\",\n  \"max_tokens\": 500,\n  \"messages\": [{\n    \"role\": \"system\",\n    \"content\": \"คุณเป็นผู้เชี่ยวชาญด้านคุณภาพอากาศและสุขภาพ ให้คำแนะนำเป็นภาษาไทย กระชับ เข้าใจง่าย\"\n  },{\n    \"role\": \"user\",\n    \"content\": \"ข้อมูลคุณภาพอากาศ ณ ตำแหน่งปัจจุบัน:\\nAQI={{ $json.aqi }}\\nPM2.5={{ $json.pm25 }} µg/m³\\nPM10={{ $json.pm10 }} µg/m³\\nโอโซน(O3)={{ $json.o3 }}\\nสถานะ={{ $json.status }}\\nสถานีวัด={{ $json.station }}\\n\\nกรุณาวิเคราะห์และให้คำแนะนำสุขภาพแบบ personalized 3-4 ประโยค บอกว่าควรทำอะไร หลีกเลี่ยงอะไร และควรสวมอุปกรณ์ป้องกันอะไรบ้าง ไม่ต้องมีหัวข้อ ไม่ต้องมี bullet point\"\n  }]\n}",
        "options": {}
      },
      "id": "8fb75fb0-2890-48de-8c01-e67209a439b1",
      "name": "AI Claude Analysis",
