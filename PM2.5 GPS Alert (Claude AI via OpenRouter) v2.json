        "message": "=<html><body style='margin:0;padding:0;background:#f0f2f5;font-family:Arial,sans-serif;'><div style='max-width:600px;margin:30px auto;background:white;border-radius:16px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,0.1);'><div style='background:{{ $json.color }};padding:30px;text-align:center;'><h1 style='color:white;margin:0;font-size:22px;'>🌫️ รายงานคุณภาพอากาศ</h1><p style='color:rgba(255,255,255,0.85);margin:8px 0 0;font-size:14px;'>ตำแหน่งปัจจุบันของคุณ</p></div><div style='padding:30px;'><p style='color:#555;font-size:16px;'>สวัสดีคุณ <strong>{{ $json.name }}</strong></p><div style='background:{{ $json.bgColor }};border:2px solid {{ $json.color }};border-radius:12px;padding:24px;text-align:center;margin:20px 0;'><div style='font-size:56px;margin-bottom:8px;'>{{ $json.emoji }}</div><div style='font-size:48px;font-weight:bold;color:{{ $json.color }};line-height:1;'>{{ $json.aqi }}</div><div style='font-size:13px;color:#888;margin-top:4px;'>AQI (Air Quality Index)</div><div style='font-size:22px;font-weight:bold;color:{{ $json.color }};margin-top:8px;'>{{ $json.status }}</div></div><table style='width:100%;border-collapse:collapse;margin:20px 0;font-size:15px;'><tr style='background:#f8f9fa;'><td style='padding:12px 16px;border:1px solid #e0e0e0;font-weight:bold;width:45%;'>🏭 สถานีวัดใกล้สุด</td><td style='padding:12px 16px;border:1px solid #e0e0e0;'>{{ $json.station }}</td></tr><tr><td style='padding:12px 16px;border:1px solid #e0e0e0;font-weight:bold;'>📍 พิกัด GPS</td><td style='padding:12px 16px;border:1px solid #e0e0e0;'>{{ $json.lat }}, {{ $json.lng }}</td></tr><tr style='background:#f8f9fa;'><td style='padding:12px 16px;border:1px solid #e0e0e0;font-weight:bold;'>🌫️ PM2.5</td><td style='padding:12px 16px;border:1px solid #e0e0e0;'>{{ $json.pm25 }} µg/m³</td></tr><tr><td style='padding:12px 16px;border:1px solid #e0e0e0;font-weight:bold;'>💨 PM10</td><td style='padding:12px 16px;border:1px solid #e0e0e0;'>{{ $json.pm10 }} µg/m³</td></tr><tr style='background:#f8f9fa;'><td style='padding:12px 16px;border:1px solid #e0e0e0;font-weight:bold;'>🌀 โอโซน (O3)</td><td style='padding:12px 16px;border:1px solid #e0e0e0;'>{{ $json.o3 }}</td></tr><tr><td style='padding:12px 16px;border:1px solid #e0e0e0;font-weight:bold;'>🕐 เวลา</td><td style='padding:12px 16px;border:1px solid #e0e0e0;'>{{ $json.time }}</td></tr></table><div style='background:#e8f4fd;border-left:5px solid #1a73e8;border-radius:8px;padding:16px;margin:20px 0;'><strong>🤖 คำแนะนำจาก AI:</strong><br/><span style='color:#333;line-height:1.8;'>{{ $json.aiAdvice }}</span></div><a href='https://www.google.com/maps?q={{ $json.lat }},{{ $json.lng }}' style='display:block;text-align:center;background:#1a73e8;color:white;padding:12px;border-radius:8px;text-decoration:none;margin-top:16px;'>📍 ดูตำแหน่งบน Google Maps</a><p style='color:#aaa;font-size:12px;text-align:center;margin-top:24px;'>ข้อมูลจาก AQICN.org · AI วิเคราะห์โดย Claude (via OpenRouter)</p></div></div></body></html>",
        "options": {}
