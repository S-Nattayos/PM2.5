    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer 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"
            },
            {
              "name": "Content-Type",
