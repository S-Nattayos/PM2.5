    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst name = body.name ?? 'ผู้ใช้งาน';\nconst email = body.email ?? '';\nconst lat = parseFloat(body.lat);\nconst lng = parseFloat(body.lng);\n\nif (!email) {\n  return [{ json: { error: true, message: 'ไม่พบ Email' } }];\n}\nif (!lat || !lng) {\n  return [{ json: { error: true, email, name, message: 'ไม่พบข้อมูล GPS' } }];\n}\n\nreturn [{\n  json: { error: false, name, email, lat, lng }\n}];"
      },
